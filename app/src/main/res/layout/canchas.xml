                        android:scaleType="centerCrop"
                        android:src="@drawable/cancha_1"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="CANCHA 3"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="#80000000"
                        android:gravity="center"
                        android:layout_gravity="top"/>

                    <Button
                        android:id="@+id/btnReservar3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ver más"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="8dp"/>
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Turnos disponibles"
                    android:textColor="#81C784"
                    android:textStyle="bold"
                    android:paddingTop="4dp"/>
            </LinearLayout>

            <!-- Cancha 4 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_cancha"
                android:padding="8dp"
                android:layout_marginBottom="12dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="180dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/cancha_1"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="CANCHA 4"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="#80000000"
                        android:gravity="center"
                        android:layout_gravity="top"/>

                    <Button
                        android:id="@+id/btnReservar4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ver más"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="8dp"/>
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Turnos disponibles"
                    android:textColor="#81C784"
                    android:textStyle="bold"
                    android:paddingTop="4dp"/>
            </LinearLayout>

            <!-- Cancha 5 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_cancha"
                android:padding="8dp"
                android:layout_marginBottom="12dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="180dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/cancha_1"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="CANCHA 5"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="#80000000"
                        android:gravity="center"
                        android:layout_gravity="top"/>

                    <Button
                        android:id="@+id/btnReservar5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ver más"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="8dp"/>
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No hay turnos disponibles"
                    android:textColor="#E57373"
                    android:textStyle="bold"
                    android:paddingTop="4dp"/>
            </LinearLayout>

            <!-- Cancha 6 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_cancha"
                android:padding="8dp"
                android:layout_marginBottom="12dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="180dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/cancha_1"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="CANCHA 6"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="#80000000"
                        android:gravity="center"
                        android:layout_gravity="top"/>

                    <Button
                        android:id="@+id/btnReservar6"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ver más"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="8dp"/>
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No hay turnos disponibles"
                    android:textColor="#E57373"
                    android:textStyle="bold"
                    android:paddingTop="4dp"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
